{
  "name": "guild-wars",
  "productName": "Guild Wars",
  "version": "2026.7.0-beta.1",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "type": "module",
  "description": "Guild Wars for macOS",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mat4m0/gwonmac.git"
  },
  "bugs": {
    "url": "https://github.com/Mat4m0/gwonmac/issues"
  },
  "main": "build/main/main.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "install-electron",
    "build": "node scripts/build.mjs",
    "dev": "pnpm build && electron-forge start",
    "tools:dev": "pnpm --filter @gwonmac/tools-ui dev",
    "tools:test": "pnpm --filter @gwonmac/tools-ui test",
    "tools:test:e2e": "pnpm --filter @gwonmac/tools-ui test:e2e",
    "ui:sweep": "node scripts/ui-visual-sweep.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.tests.json && pnpm --filter @gwonmac/tools-ui typecheck",
    "lint": "eslint .",
    "check:links": "node --import ./scripts/ts-hook.mjs --experimental-strip-types scripts/check-markdown-links.ts",
    "test:unit": "node --import ./scripts/ts-hook.mjs --experimental-strip-types --test tests/unit/*.ts",
    "test:integration": "node --import ./scripts/ts-hook.mjs --experimental-strip-types --test tests/integration/*.ts",
    "test:electron": "playwright test --config=tests/electron/playwright.config.ts",
    "test:packaged": "node --import ./scripts/ts-hook.mjs --experimental-strip-types tests/packaged-smoke.ts && node --import ./scripts/ts-hook.mjs --experimental-strip-types tests/packaged-enhancement-runtime.ts",
    "test:policy": "node --import ./scripts/ts-hook.mjs --experimental-strip-types --test tests/policy/*.ts",
    "test:release": "node --import ./scripts/ts-hook.mjs --experimental-strip-types --test tests/release/*.ts",
    "enhancements:live": "pnpm build && node --import ./scripts/ts-hook.mjs --experimental-strip-types scripts/enhancements-live.ts",
    "enhancements:doctor": "pnpm build && node build/tools/enhancement-doctor.js",
    "enhancements:recertify": "pnpm build && node build/tools/enhancement-recertify.js",
    "enhancements:visual": "pnpm build && node --import ./scripts/ts-hook.mjs --experimental-strip-types scripts/enhancements-visual.ts",
    "enhancements:transform": "pnpm build && node build/tools/enhancement-transform.js",
    "template:recertify": "pnpm build && node build/tools/template-save-recertify.js",
    "snapshot:prune": "node --import ./scripts/ts-hook.mjs --experimental-strip-types scripts/snapshot-retention.ts",
    "test:website": "pnpm --filter gw-website typecheck && pnpm --filter gw-website generate && pnpm --filter gw-website build && node --import ./scripts/ts-hook.mjs --experimental-strip-types tests/website-smoke.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm check:links && pnpm test:unit && pnpm test:policy && pnpm tools:test",
    "test": "pnpm build && pnpm test:unit && pnpm test:integration && pnpm test:electron",
    "package": "pnpm build && node scripts/clean-output.mjs && electron-forge package",
    "make": "pnpm build && node scripts/clean-output.mjs && electron-forge make",
    "diagnostics:validate": "tsc && node build/tools/diagnostics/validate.js",
    "diagnostics:summarize": "tsc && node build/tools/diagnostics/summarize.js",
    "diagnostics:compare": "tsc && node build/tools/diagnostics/compare.js",
    "diagnostics:attribute-stalls": "tsc && node build/tools/diagnostics/attribute-stalls.js",
    "diagnostics:attribute-frames": "tsc && node build/tools/diagnostics/attribute-frames.js",
    "verify": "pnpm typecheck && pnpm lint && pnpm check:links && pnpm test && pnpm test:policy && pnpm test:release && pnpm package && pnpm test:packaged"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron/asar": "^3.4.1",
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "electron": "^43.2.0",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.10.0",
    "playwright": "^1.55.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
