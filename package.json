{
  "name": "guild-wars",
  "productName": "Guild Wars Reforged",
  "version": "2026.8.9",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "type": "module",
  "description": "Guild Wars Reforged for macOS",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mat4m0/gwonmac.git"
  },
  "bugs": {
    "url": "https://github.com/Mat4m0/gwonmac/issues"
  },
  "main": "build/main/main.js",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "postinstall": "install-electron",
    "build": "node scripts/build.mjs",
    "dev": "pnpm build && electron-forge start",
    "dev:signed": "node --import ./scripts/ts-hook.mjs scripts/run-signed-dev.ts",
    "test:signed-dev": "node --import ./scripts/ts-hook.mjs scripts/run-signed-dev.ts --test-keychain",
    "tools:dev": "pnpm --filter @gwonmac/tools-ui dev",
    "tools:test": "pnpm --filter @gwonmac/tools-ui test",
    "tools:test:e2e": "pnpm --filter @gwonmac/tools-ui test:e2e",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.tests.json && pnpm --filter @gwonmac/tools-ui typecheck",
    "lint": "eslint .",
    "check:links": "node --import ./scripts/ts-hook.mjs scripts/check-markdown-links.ts",
    "test:unit": "node --import ./scripts/ts-hook.mjs --test --test-timeout=60000 tests/unit/*.ts",
    "test:client-artifact": "node --import ./scripts/ts-hook.mjs --test --test-timeout=60000 tests/client-artifact/*.ts",
    "test:integration": "node --import ./scripts/ts-hook.mjs --test --test-timeout=60000 tests/integration/*.ts",
    "test:electron": "playwright test --config=tests/electron/playwright.config.ts",
    "test:packaged": "node --import ./scripts/ts-hook.mjs tests/packaged-smoke.ts && node --import ./scripts/ts-hook.mjs tests/packaged-enhancement-runtime.ts",
    "test:signed-keychain": "node --import ./scripts/ts-hook.mjs tests/signed-keychain-runtime.ts",
    "test:stable-beta-roundtrip": "node --import ./scripts/ts-hook.mjs scripts/verify-stable-beta-roundtrip.ts",
    "release:test": "node --import ./scripts/ts-hook.mjs scripts/test-draft-release.ts",
    "verify:signed-app": "node --import ./scripts/ts-hook.mjs scripts/verify-signed-app.ts",
    "test:policy": "node --import ./scripts/ts-hook.mjs --test --test-timeout=60000 tests/policy/*.ts",
    "test:release": "node --import ./scripts/ts-hook.mjs --test --test-timeout=60000 tests/release/*.ts",
    "enhancements:live": "pnpm build && node --import ./scripts/ts-hook.mjs scripts/enhancements-live.ts",
    "graphics:live": "GW_LIVE_SMOKE=1 pnpm enhancements:live -- --scenario graphics-probe",
    "certification": "pnpm build && node build/tools/certification.js",
    "client:official": "node --import ./scripts/ts-hook.mjs scripts/official-client.ts",
    "enhancements:visual": "pnpm build && node --import ./scripts/ts-hook.mjs scripts/enhancements-visual.ts",
    "font:calibrate": "pnpm build && node --import ./scripts/ts-hook.mjs scripts/calibrate-game-font.ts",
    "enhancements:kernel:verify": "pnpm build && node scripts/verify-companion-kernel.mjs",
    "test:website": "pnpm --filter gw-website certify && node --import ./scripts/ts-hook.mjs tests/website-smoke.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm check:links && pnpm test:unit && pnpm test:policy && pnpm tools:test",
    "test": "pnpm verify:runtime",
    "package": "pnpm build && pnpm package:built",
    "package:built": "node scripts/verify-companion-kernel.mjs && node scripts/clean-output.mjs && electron-forge package",
    "make": "pnpm build && node scripts/clean-output.mjs && electron-forge make",
    "diagnostics:validate": "tsc && node build/tools/diagnostics/validate.js",
    "diagnostics:summarize": "tsc && node build/tools/diagnostics/summarize.js",
    "diagnostics:compare": "tsc && node build/tools/diagnostics/compare.js",
    "diagnostics:attribute-stalls": "tsc && node build/tools/diagnostics/attribute-stalls.js",
    "diagnostics:attribute-frames": "tsc && node build/tools/diagnostics/attribute-frames.js",
    "diagnostics:visual": "tsc && node build/tools/diagnostics/visual.js",
    "memory:qualify:4gb": "node --import ./scripts/ts-hook.mjs scripts/qualify-extended-memory.ts",
    "verify:runtime": "pnpm check && pnpm build && node scripts/verify-companion-kernel.mjs && pnpm test:integration && pnpm test:release && pnpm tools:test:e2e && pnpm test:electron",
    "verify": "pnpm verify:runtime && pnpm package:built && pnpm test:packaged"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@electron/asar": "^3.4.1",
    "@electron/fuses": "^2.1.3",
    "@electron/osx-sign": "1.3.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.13.3",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.18.1",
    "electron": "^43.4.1",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.10.0",
    "node-api-headers": "1.9.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.55.0",
    "plist": "3.1.1",
    "pngjs": "^7.0.0",
    "rollup": "^4.62.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
