{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true
  },
  "include": [
    "src/renderer/**/*.js",
    "src/renderer/**/*.d.ts",
    "src/shared/contracts.ts",
    "src/shared/diagnostics.ts"
  ]
}
