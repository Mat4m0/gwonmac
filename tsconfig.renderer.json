{
  // TypeScript owns renderer type safety only. Rollup is the one runtime
  // producer and writes the renderer's complete closure under build/renderer.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    // tsconfig.json owns why each of these is on; src is one tree, and the half
    // of it that compiles for Chromium is held to the same bar.
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true
  },
  // src/shared is reached through the renderer's imports, so listing two of its
  // files here only ever said which two the author happened to think of.
  //
  // One extension: the renderer holds no JavaScript, so `allowJs`, `checkJs` and
  // a `**/*.js` glob went with the last file they applied to. `**/*.ts` subsumes
  // the ambient `src/renderer/gw-native.d.ts` that used to be named separately.
  "include": ["src/renderer/**/*.ts"]
}
